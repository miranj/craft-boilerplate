{
  "name": "miranj/craft-boilerplate",
  "description": "A Craft CMS 5 starter project by Miranj",
  "keywords": [
    "craft",
    "cms",
    "craftcms",
    "project",
    "miranj"
  ],
  "license": "MIT",
  "homepage": "https://miranj.in/",
  "type": "project",
  "minimum-stability": "dev",
  "prefer-stable": true,
  "repositories": [
    {
      "type": "package",
      "package": {
        "name": "tailwindlabs/heroicons",
        "version": "2.1.5",
        "source": {
          "url": "https://github.com/tailwindlabs/heroicons.git",
          "type": "git",
          "reference": "v2.1.5"
        }
      }
    },
    {
      "type": "git",
      "url": "https://github.com/brandonkelly/craft-twig_perversion"
    }
  ],
  "require": {
    "aodihis/video-utils": "^3.0",
    "craftcms/ckeditor": "^4.1",
    "craftcms/cms": "~5.9.0",
    "craftcms/store-hours": "^4.2",
    "marionnewlevant/twig-perversion": "v5.x-dev",
    "miranj/craft-obfuscator": "^1.2",
    "miranj/craft-router": "^1.7",
    "mmikkel/child-me": "^2.2",
    "mmikkel/retcon": "^3.1",
    "nystudio107/craft-minify": "^5.0",
    "nystudio107/craft-typogrify": "^5.0",
    "spacecatninja/imager-x": "^5.0",
    "tailwindlabs/heroicons": "^2.1",
    "topshelfcraft/environment-label": "^5.0",
    "ttempleton/craft-nocache": "^3.0",
    "vaersaagod/seomate": "^3.0@beta",
    "verbb/element-index-defaults": "^4.0",
    "verbb/field-manager": "^4.0",
    "verbb/image-resizer": "^4.0",
    "verbb/navigation": "^3.0",
    "vlucas/phpdotenv": "^5.6",
    "wrav/oembed": "^3.1",
    "yiisoft/yii2-redis": "^2.1"
  },
  "require-dev": {
    "craftcms/generator": "^2.0.0",
    "craftcms/phpstan": "dev-main",
    "yiisoft/yii2-shell": "^2.0"
  },
  "autoload": {
    "psr-4": {
      "boilerplate\\": "src/"
    }
  },
  "config": {
    "allow-plugins": {
      "craftcms/plugin-installer": true,
      "yiisoft/yii2-composer": true
    },
    "sort-packages": true,
    "optimize-autoloader": true,
    "platform": {
      "php": "8.2"
    }
  },
  "scripts": {
    "phpstan": "phpstan --memory-limit=1G",
    "post-create-project-cmd": [
      "@php -r \"copy('.env.example', '.env');\"",
      "@php -r \"unlink('composer.json');\"",
      "@php -r \"unlink('LICENSE');\"",
      "@php -r \"unlink('README.md');\"",
      "@php -r \"rename('README.md.default', 'README.md');\"",
      "@php -r \"unlink('CHANGELOG.md');\"",
      "@php -r \"rename('CHANGELOG.md.default', 'CHANGELOG.md');\"",
      "@php -r \"rename('composer.json.default', 'composer.json');\"",
      "@php -r \"copy('serverconfigs/apache-dev/sample.htaccess', 'web/.htaccess');\"",
      "rm -rf field-library",
      "@composer dump-autoload -o"
    ],
    "post-install-cmd": [
      "@php craft install/check",
      "@php craft up --interactive=0 || exit 0",
      "@php craft invalidate-tags/template || exit 0"
    ]
  }
}
