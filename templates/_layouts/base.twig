{% extends '_layouts/html' %}
{% from '_helpers/text' import normaliseRichtext %}



{% block page %}
  {#
    Params
  #}
  {% set siteLogo = siteLogo ?? null %}
  
  
  
  {#
    Layout
  #}
  {{ block('page_header') }}
  {{ block('page_main') }}
  {{ block('page_footer') }}
  {{ block('page_admin') }}
{% endblock %}



{#
  Render
#}
{% block page_main %}
  <main class="{% block main_class '' %}">
    {% block main %}{% endblock %}
  </main>
{% endblock %}



{% block page_header %}
  <header class="container">
    <h2 class="{{ siteLogo ? 'w-4xl sm:w-5xl' }}">
      <a href="{{ url() }}" title="Visit the {{ siteName }} home page">
        {% if siteLogo %}
          {% include '_components/_image' with { params: {
            asset: siteLogo,
            preset: 'logo',
            lazyload: false,
          } } %}
        {% else %}
          {{ siteName }}
        {% endif %}
      </a>
    </h2>
  </header>
{% endblock %}



{% block page_footer %}
  <footer class="container">
    <div {{ attr({
      class: [
        'py-12 flex flex-col sm:flex-row gap-8',
        'items-start justify-between',
        'border-t',
      ],
    }) }}>
      {% if footer.caption %}
        <div class="sm:max-w-1/4 w-full richtext">
          {{ normaliseRichtext(footer.caption) }}
        </div>
      {% endif %}
      {% include '_components/footerNav' with { params: {
        class: '',
        handle: 'footer',
        ariaLabel: 'Footer site navigation',
        profile: 'footer',
      } } %}
    </div>
    
    <div {{ attr({
      class: [
        'flex flex-col sm:flex-row justify-between gap-y-6',
        'py-4 prose-meta',
        'border-t',
      ],
    }) }}>
      <div class="richtext">
        {% if footer.copyright %}
          {{ normaliseRichtext(footer.copyright) }}
        {% else %}
          <p>
            &copy; {{ now|date('Y') }} {{ siteName }}
          </p>
        {% endif %}
      </div>
      {% include '_components/footerNav' with { params: {
        handle: 'finePrint',
        profile: 'finePrint',
        ariaLabel: 'Footer fine print navigation',
      } } %}
    </div>
  </footer>
{% endblock %}



{% block page_admin %}
  {% if entry is defined %}
    {% nocache with {
      editUrl: entry.cpEditUrl ?? false ? url(entry.getCpEditUrl(), { returnUrl: '{url}'|hash }),
      sectionUID: (entry.getRootOwner ?: entry.owner ?: entry).section.uid ?? false,
    } %}
      {% if currentUser
        and editUrl
        and not (craft.app.request.isLivePreview or craft.app.request.isPreview)
        and (
          not sectionUID
          or currentUser.can('saveEntries:' ~ sectionUID)
        )
      %}
        <div class="z-floating fixed" style="right:0;bottom:10%">
          {{ tag('a', {
            class: [
              'block px-3.5 py-1.5',
              'text-sm',
              'rounded-s',
              'bg-black text-white',
              'hover:no-underline hover:opacity-50',
            ],
            style: {
              'font-family': 'system-ui,ui-sans-serif,sans-serif',
            },
            href: editUrl,
            text: 'Edit',
          }) }}
        </div>
      {% endif %}
    {% endnocache %}
  {% endif %}
{% endblock %}
