{#
  _cp/urls/people.twig

  Set a URL based on a set of conditions.

  People marked as "Alumni" or with a single "Ambassador" role will not have
  a URL.
#}

{# Params #}
{% set entryRoles = entryRoles ?? object.personRoles|column('value') %}
{% set entryIsActive = entryIsActive ?? not (object.isAlumni ?? false) %}



{# Variables #}
{% set rolesWithUrl = ['faculty', 'staff', 'student'] %}



{# Variables #}
{% set personHasUrl =
  entryRoles|intersect(rolesWithUrl) is not empty
  and entryIsActive
%}



{# Render #}
{{ personHasUrl ? 'people/' ~ object.slug : '' }}
