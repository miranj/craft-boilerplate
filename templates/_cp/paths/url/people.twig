{#
  _cp/paths/url/people.twig

  Set a URL based on a set of conditions.
#}

{# Params #}
{% set personRoles = personRoles ?? object.roles|map(e => e.value) %}
{% set personIsActive = personIsActive ?? not (object.isAlumni ?? false) %}



{# Variables #}
{% set personIsAmbassadorOnly = (personRoles|length == 1) and ('ambassador' in personRoles) %}
{% set personHasUrl =
  personIsActive
  and not personIsAmbassadorOnly
%}



{# Render #}
{{ personHasUrl ? 'members/' ~ object.slug : '' }}
