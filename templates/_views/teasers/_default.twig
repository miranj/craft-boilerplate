{# _views/teasers/_default #}
{% extends '_layouts/blank' %}



{#
  Params
#}
{% set teaserTitle = teaserTitle ?? element.title %}
{% set teaserUrl = teaserUrl ?? element.url ?? '' %}



{#
  Render
#}
{% block block_teaser_class 'flex' %}

{% block layout %}
  {% block teaser %}
    <article>
      {% tag (teaserUrl ? 'a' : 'div') with {
        href: teaserUrl ?: null,
        class: [
          block('block_teaser_class'),
        ],
      } %}
        {% block teaser_body %}

          {% block teaser_title %}
            {% if teaserUrl %}
              <span class="{% block teaser_title_class '' %}">
                {{ teaserTitle }}
              </span>
            {% else %}
              {{ teaserTitle }}
            {% endif %}
          {% endblock %}

        {% endblock %}
      {% endtag %}
    </article>
  {% endblock %}
{% endblock %}
