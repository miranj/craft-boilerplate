{# _views/indexes/_default #}
{% extends '_views/indexes/_preflight' %}



{#
  Params
#}
{% set indexTitle = indexTitle ?? entry.title %}
{% set indexSeoTitle = indexSeoTitle ?? indexTitle %}
{% set indexSeoTitleSuffix = indexSeoTitleSuffix ?? '' %}
{% set indexView = indexView ?? 'teaser' %}
{% set indexGroupedView = indexGroupedView ?? 'teaser' %}

{% block main %}
  {% set detailTitle = indexTitle %}

  {{ parent() }}
{% endblock %}

{# SEO #}
{% block seo %}
  {% set seomate = {
    element: entry,
    canonicalUrl: entry.url,
    meta: {
      title: [
        (entry.seoTitle ?? indexSeoTitle ?? indexTitle)|striptags,
        indexSeoTitleSuffix,
        ((indexPaginateInfo.currentPage ?? 0) > 1 ? "(page #{indexPaginateInfo.currentPage})")
      ]|filter|join(' '),
      description: entry.seoSummary
        ?: ('All '
          ~ [
            indexTitle|striptags|lcfirst,
            indexSeoTitleSuffix
          ]
            |filter
            |join(' ')
        ),
      robots: indexActiveFilters|length > 1 ? 'noindex',
      links: [
        {
          rel: 'alternate',
          type: 'application/rss+xml',
          title: "#{siteName} #{indexTitle} Feed",
          href: entry.url ~ '/feed.xml',
        },
        (indexPaginateInfo.getPrevUrl() ?? false) ? { rel: 'prev', href: indexPaginateInfo.getPrevUrl() } : null,
        (indexPaginateInfo.getNextUrl() ?? false) ? { rel: 'next', href: indexPaginateInfo.getNextUrl() } : null,
      ]|filter,
    }|filter,
    config: {
      cacheEnabled: false,
    },
  }|merge(seomate ?? {}, true) %}

  {{ parent() }}
{% endblock %}



{#
  Layout
#}
{% block detail_layout %}
  <article class="{{ block('detail_layout_class') }}">
    {{ block('index_header') }}
    {{ block('index_meta') }}
    {{ block('index_body') }}
  </article>
{% endblock %}



{#
  Render
#}
{% block index_header block('detail_header') %}



{# Body #}
{% block index_meta %}
  {% set _block_index_meta_inner = block('index_meta_inner') %}
  {% if _block_index_meta_inner|trim is not empty %}
    <div class="container mt-10">
      {{ _block_index_meta_inner|raw }}
    </div>
  {% endif %}
{% endblock %}
{% block index_meta_inner %}
{% endblock %}

{% block index_body %}
  <div class="{% block index_body_class 'py-10' %}">
    {% if indexGroupedEntries is not empty %}
      {{ block('index_list_grouped') }}
    {% elseif indexEntries is not empty %}
      {{ block('index_list_flat') }}
    {% elseif block('index_body_empty')|trim %}
      <div class="{% block index_body_empty_class 'container' %}">
        {% apply md|typogrify %}
          {%- block index_body_empty -%}
            No {{ section.name|pluralize }} at the moment.
          {% endblock %}
        {% endapply %}
      </div>
    {% endif %}
  </div>
{% endblock %}

{# Grouped index #}
{% block index_list_grouped_class 'container space-y-7' %}
{% block index_list_grouped %}
  {% include '_components/metaInfo' with { params: {
    items: indexGroupedEntries,
    class: block('index_list_grouped_class'),
    item_class: 'p-4',
    body_class: 'p-4',
    title_class: '',
    link_class: '',
    defaults: {
      lister: { kind: indexGroupedView },
      autoPluralize: false,
      generateAnchors: true,
    },
  } } %}

  {{ block('index_pagination') }}
{% endblock %}

{# Non-grouped, regular index #}
{% block index_list_flat_class 'container' %}
{% block index_list_flat %}
  {% include '_components/_lister' with { params: {
    class: block('index_list_flat_class'),
    entries: indexEntries,
    item_class: 'p-4',
    kind: indexView,
  } } %}

  {{ block('index_pagination') }}
{% endblock %}


{# Pagination #}
{% block index_pagination %}
  {% if indexPaginateInfo.totalPages ?? false > 1 %}
    <nav aria-label="Pagination" {{ attr({ class: [
      'container py-10 flex justify-between items-center',
    ] }) }}>

      {% set previousUrl = indexPaginateInfo.getPrevUrl() %}
      {% set nextUrl = indexPaginateInfo.getNextUrl() %}
      {% if previousUrl or nextUrl %}
        {% set _paginationNav = [{
          label: 'Previous page',
          url: previousUrl,
          class: not previousUrl ? 'text-slate-500',
        },{
          label: 'Page ' ~ [
            "%02d"|format(craft.app.request.getPageNum()),
            "%02d"|format(indexPaginateInfo.totalPages),
          ]
            |join(' of '),
          url: null,
          isCurrent: true,
        },{
          label: 'Next page',
          url: nextUrl,
          class: not nextUrl ? 'text-slate-500',
        }] %}

        {% for item in _paginationNav %}
          {{ tag(item.url ? 'a' : 'span', {
            text: item.label,
            href: item.url ?: null,
            title: item.url ? item.label : null,
            class: [
              'p-2',
              item.class ?? null,
            ],
            'aria-current': (item.isCurrent ?? false) ? 'page' : null,
            'aria-disabled': not item.url and not (item.isCurrent ?? false) ? 'true' : null,
          }) }}
        {% endfor %}
      {% endif %}
    </nav>
  {% endif %}
{% endblock %}
