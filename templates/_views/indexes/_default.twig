{# _views/indexes/_default #}
{% extends '_views/indexes/_preflight' %}



{#
  Params
#}
{% set indexTitle = indexTitle ?? entry.title %}
{% set indexSeoTitle = indexSeoTitle ?? indexTitle %}
{% set indexSeoTitleSuffix = indexSeoTitleSuffix ?? '' %}
{% set indexView = indexView ?? 'teaser' %}
{% set indexGroupedView = indexGroupedView ?? 'title' %}
{% set indexBreadcrumb = indexBreadcrumb ?? null %}

{% block main %}
  {% set detailTitle = indexTitle %}

  {{ parent() }}
{% endblock %}

{# SEO #}
{% block seo %}
  {% set seomate = {
    element: entry,
    canonicalUrl: entry.url,
    meta: {
      title: [
        (entry.seoTitle ?? indexSeoTitle ?? indexTitle)|striptags,
        indexSeoTitleSuffix,
        ((indexPaginateInfo.currentPage ?? 0) > 1 ? "(page #{indexPaginateInfo.currentPage})")
      ]|filter|join(' '),
      description: entry.seoSummary
        ?: ('All '
          ~ [
            indexBreadcrumb ?? '',
            indexTitle|striptags|lcfirst,
            indexSeoTitleSuffix
          ]
            |filter
            |join(' ')
        ),
      robots: indexActiveFilters|length > 1 ? 'noindex',
      links: [{
        rel: 'alternate',
        type: 'application/rss+xml',
        title: "#{siteName} #{indexTitle} Feed",
        href: entry.url ~ '/feed.xml',
      }],
    }|filter,
    config: {
      cacheEnabled: false,
    },
  }|merge(seomate ?? {}, true) %}

  {{ parent() }}
{% endblock %}



{#
  Layout
#}
{% block detail_layout %}
  <article class="{{ block('detail_layout_class') }}">
    {{ block('index_header') }}
    {{ block('index_meta') }}
    {{ block('index_body') }}
  </article>
{% endblock %}



{#
  Render
#}
{% block index_header block('detail_header') %}

{% block detail_breadcrumbs %}
  {% if indexBreadcrumb %}
    <div class="flex items-baseline gap-1 mb-2 text-md">
      {{ indexBreadcrumb }}
    </div>
  {% else %}
    {{ parent() }}
  {% endif %}
{% endblock %}

{% block detail_title %}
  <div class="flex gap-x-1 md:gap-x-2">
    {{ parent() }}
  </div>
{% endblock %}



{# Body #}
{% block index_meta %}
{% endblock %}

{% block index_body %}
  <div class="{% block index_body_class 'pt-10 pb-14 md:pt-14 md:pb-28' %}">
    {% if indexGroupedEntries is not empty %}
      {{ block('index_list_grouped') }}
    {% elseif indexEntries is not empty %}
      {{ block('index_list_flat') }}
    {% elseif block('index_body_empty')|trim %}
      <div class="{% block index_body_empty_class 'container' %}">
        {% apply md|typogrify %}
          {%- block index_body_empty -%}
            No {{ section.name|pluralize }} at the moment.
          {% endblock %}
        {% endapply %}
      </div>
    {% endif %}
  </div>
{% endblock %}

{# Grouped index #}
{% block index_list_grouped_class 'space-y-7 md:space-y-10' %}
{% block index_list_grouped %}
  {% include '_components/metaInfo' with { params: {
    items: indexGroupedEntries,
    class: block('index_list_grouped_class'),
    item_class: '',
    title_class: 'container font-title',
    link_class: '',
    defaults: {
      lister: { kind: indexGroupedView },
      autoPluralize: false,
      generateAnchors: true,
    },
  } } %}
{% endblock %}

{# Non-grouped, regular index #}
{% block index_list_flat_class 'container' %}
{% block index_list_flat %}
  {% include '_components/_lister' with { params: {
    class: block('index_list_flat_class'),
    entries: indexEntries,
    kind: indexView,
  } } %}

  {{ block('index_pagination') }}
{% endblock %}


{# Pagination #}
{% block index_pagination %}
  {% if indexPaginateInfo.totalPages ?? false > 1 %}
    <div {{ attr({ class: [
      'container mt-10 md:mt-14 flex justify-between',
      'text-2xs md:text-base',
    ] }) }}>
      <span class="flex-item">
        {{ "%02d"|format(craft.app.request.getPageNum()) }}—{{ "%02d"|format(indexPaginateInfo.totalPages) }}
      </span>

      {% if indexPaginateInfo.getPrevUrl() or indexPaginateInfo.getNextUrl() %}
        <div class="flex gap-x-7 md:gap-x-8">
          {% set _paginationNav = [{
            label: 'Previous',
            url: indexPaginateInfo.getPrevUrl(),
            icon: '@icons/arrow-left.svg',
          },{
            label: 'Next',
            url: indexPaginateInfo.getNextUrl(),
            icon: '@icons/arrow-right.svg',
          }] %}

          {% for item in _paginationNav %}
            {{ tag(item.url ? 'a' : 'span', {
              html: svgIcon(alias(item.icon))
                |attr({ class: 'size-5.5 md:size-6' })
                ~ ' ' ~
                tag('span', {
                  text: item.label ~ ' page',
                  class: 'sr-only'
                }
              ),
              href: item.url ?: null,
              title: item.url ? item.label ~ ' page' : null,
              class: [
                'inline-block py-2',
                not item.url ? 'text-slate-500',
              ],
            }) }}
          {% endfor %}
        </div>
      {% endif %}
    </div>
  {% endif %}
{% endblock %}
