{% extends '_views/indexes/_preflight' %}



{# Params #}
{% set indexTitle = indexTitle ?? entry.title %}
{% set indexSeoTitle = indexSeoTitle ?? indexTitle %}
{% set indexSeoTitleSuffix = indexSeoTitleSuffix ?? '' %}
{% set indexView = indexView ?? 'teaser' %}
{% set indexOrderedBy = indexOrderedBy ?? 'postDate DESC' %}
{% set indexPaginate = indexPaginate ?? true %}
{% set indexPaginateCount = indexPaginateCount ?? 12 %}
{% set indexActiveFilters = indexActiveFilters ?? [] %}



{# Biz logic #}
{% block response %}
  {# Configure entries query #}
  {% if indexOrderedBy %}
    {% do entries.orderBy(indexOrderedBy) %}
  {% endif %}

  {# Build final entries list #}
  {% if indexPaginate %}
    {% paginate clone(entries).limit(indexPaginateCount) as indexPaginateInfo, indexEntries %}
    {# If page number is not valid (greater than total), 404 #}
    {% if craft.app.request.getPageNum() > indexPaginateInfo.totalPages %}
      {% exit 404 %}
    {% endif %}
  {% else %}
    {% set indexEntries = indexEntries ?? collect(entries).all() %}
  {% endif %}

  {# 404 if no entries due to filters #}
  {% if indexEntries is empty and indexActiveFilters is not empty %}
    {% do craft.app.response.setStatusCode('404') %}
  {% endif %}

  {{ parent() }}
{% endblock %}

{% block seo %}
  {% set seomate = {
    element: entry,
    canonicalUrl: entry.url,
    meta: {
      title: [
        (entry.seoTitle ?? indexSeoTitle ?? indexTitle)|striptags,
        indexSeoTitleSuffix,
        ((indexPaginateInfo.currentPage ?? 0) > 1 ? "(page #{indexPaginateInfo.currentPage})")
      ]|filter|join(' '),
      description: entry.seoSummary ?? '',
      robots: indexActiveFilters|length > 1 ? 'noindex',
      links: [{
        rel: 'alternate',
        type: 'application/rss+xml',
        title: "#{siteName} #{indexTitle} Feed",
        href: entry.url ~ '/feed.xml',
      }],
    }|filter,
    config: {
      cacheEnabled: false,
    },
  } %}

  {{ parent() }}
{% endblock %}



{# Layout #}
{% block main %}
  <article>
    {{ block('index_header') }}
    {{ block('index_body') }}
    {{ block('index_pagination') }}
  </article>
{% endblock %}



{# Render #}
{% block index_header %}
  <header class="{% block index_header_class 'container py-4' %}">
    <h1 class="{% block index_title_class 'title-h2' %}">
      {{ entry.title }}
    </h1>
  </header>
{% endblock %}

{% block index_body %}
  {% include '_components/_lister' with { params: {
    class: 'container',
    entries: indexEntries,
    kind: indexView,
  } } %}
{% endblock %}

{% block index_pagination %}
{% endblock %}
