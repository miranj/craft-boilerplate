{# _views/indexes/resources #}

{% extends '_views/indexes/_default-filtered' %}
{% from '_helpers/filters' import elementsFilter, getAllActiveEntriesIds %}



{# Params #}
{% set indexPaginateCount = indexPaginateCount ?? 12 %}



{# Filters #}
{% block response %}
  {% set indexFilters = indexFilters ?? [
    elementsFilter('resourceType', 'Resource Type', craft.categories({
      group: 'resourcesTypes',
      relatedTo: getAllActiveEntriesIds(section),
    })),
    elementsFilter('department', 'Department', craft.entries({
      section: 'departments',
      relatedTo: getAllActiveEntriesIds(section),
      orderBy: 'title asc',
    })),
    elementsFilter('office', 'Office', craft.entries({
      section: 'offices',
      relatedTo: getAllActiveEntriesIds(section),
    })),
  ] %}
  {{ parent() }}
{% endblock %}
