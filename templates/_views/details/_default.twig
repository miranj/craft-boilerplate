{% extends '_layouts/base' %}



{# Params #}
{% set detailTitle = detailTitle ?? entry.title %}



{# Biz Logic #}
{% block response %}
  {# If non-paginated detail view has a page number, 404 #}
  {% if craft.app.request.getPageNum() > 1 and not (indexPaginate ?? false) %}
    {% exit 404 %}
  {% endif %}
  
  {{ parent() }}
{% endblock %}



{% block main %}
  {#
    Layout
  #}
  {% block detail_layout %}
    <article class="{% block detail_layout_class '' %}">
      {{ block('detail_header') }}
    </article>
  {% endblock %}
{% endblock %}



{% block detail_header %}
  <header class="{% block detail_header_class 'container py-8' %}">
    {% block detail_title %}
      {% if detailTitle %}
        <h1 class="{% block detail_title_class 'title-h1' %}">
          {{ detailTitle|typogrify(true) }}
        </h1>
      {% endif %}
    {% endblock %}
  </header>
{% endblock %}



{# SEO #}
{% block jsonld %}
  {% include '_routers/jsonld' with { entry: entry } %}
{% endblock %}
