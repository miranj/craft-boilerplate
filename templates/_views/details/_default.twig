{% extends '_layouts/base' %}



{# Biz Logic #}
{% block response %}
  {# If non-paginated detail view has a page number, 404 #}
  {% if craft.app.request.getPageNum() > 1 and not (indexPaginate ?? false) %}
    {% exit 404 %}
  {% endif %}
  
  {{ parent() }}
{% endblock %}



{% block main %}
  {#
    Layout
  #}
  {% block detail_layout %}
    <article class="{% block detail_layout_class '' %}">
    </article>
  {% endblock %}
{% endblock %}



{% block detail_header %}
  <header class="{% block detail_header_class 'py-8' %}">
    <div class="container">
      {% block detail_title %}
        {% if detailTitle %}
          <h1 class="{% block detail_title_class 'title-h1' %}">
            {{ detailTitle|typogrify(true) }}
          </h1>
        {% endif %}
      {% endblock %}
    </div>
  </header>
{% endblock %}



{# SEO #}
{% block jsonld %}
  {% include '_routers/jsonld' with { entry: entry } %}
{% endblock %}
