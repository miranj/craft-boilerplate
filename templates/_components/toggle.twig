{# _components/toggle #}



{#
  Params
#}
{% set toggleClass = params.class ?? '' %}
{% set toggleTitle = params.title ?? '' %}
{% set toggleBody = params.body ?? null %}
{% set toggleTitleClass = params.title_class ?? 'title-h3 font-title font-bold' %}
{% set toggleBodyClass = params.body_class ?? 'richtext pt-3 md:pt-6' %}



{#
  Render
#}
{% if toggleTitle or toggleBody %}
  <details {{ attr({ class: toggleClass }) }}>
    {% if toggleTitle %}
      <summary {{ attr({ class: toggleTitleClass }) }}>
        {{ toggleTitle }}
      </summary>
    {% endif %}
    <div {{ attr({ class: toggleBodyClass }) }}>
      {{ toggleBody }}
    </div>
  </details>
{% endif %}
